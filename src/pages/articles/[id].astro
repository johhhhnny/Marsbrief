---
import { render } from "astro:content";
import BaseLayout from "@/layouts/base.astro";
import ContentLayout from "@/layouts/content.astro";
import ArticleHeader from "./_components/article-header.astro";
import NewsCard from "@/components/cards/newsCard.astro";
import GiscusComments from "@/components/elements/giscus-comments.astro";

import { articlesHandler } from "@/lib/handlers/articles";
import { categoriesHandler } from "@/lib/handlers/categories";

export const getStaticPaths = async () => {
  const articles = await articlesHandler.allArticles();

  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
};
const { article } = Astro.props;

const { Content, remarkPluginFrontmatter } = await render(article);
const [allArticles, articleCategories] = await Promise.all([
  articlesHandler.allArticles(),
  categoriesHandler.allCategoriesForArticle(article),
]);
const normalizeTag = (tag: string) => tag.trim().toLowerCase();
const articleTags = new Set(article.data.tags.map(normalizeTag));
const taggedRelatedArticles = allArticles
  .filter((candidate) => candidate.id !== article.id)
  .map((candidate) => {
    const candidateTags = new Set(candidate.data.tags.map(normalizeTag));
    const sharedTagCount = [...articleTags].filter((tag) =>
      candidateTags.has(tag),
    ).length;
    const sharedCategoryCount = articleCategories.reduce((count, category) => {
      if (!category) return count;

      const sharesCategory =
        categoriesHandler.articleHasCategory(candidate, category.id) ||
        categoriesHandler.articleHasCategory(candidate, category.data.path);

      return count + Number(sharesCategory);
    }, 0);

    return { candidate, sharedTagCount, sharedCategoryCount };
  })
  .filter(({ sharedTagCount }) => sharedTagCount > 0)
  .sort(
    (a, b) =>
      b.sharedTagCount - a.sharedTagCount ||
      b.sharedCategoryCount - a.sharedCategoryCount ||
      new Date(b.candidate.data.publishedTime).getTime() -
        new Date(a.candidate.data.publishedTime).getTime(),
  );
const selectedTagRelatedArticles = taggedRelatedArticles
  .slice(0, 3)
  .map(({ candidate }) => candidate);
const selectedArticleIds = new Set(
  selectedTagRelatedArticles.map((candidate) => candidate.id),
);
const categoryFallbackArticles = allArticles
  .filter(
    (candidate) =>
      candidate.id !== article.id &&
      !selectedArticleIds.has(candidate.id) &&
      articleCategories.some(
        (category) =>
          category &&
          (categoriesHandler.articleHasCategory(candidate, category.id) ||
            categoriesHandler.articleHasCategory(
              candidate,
              category.data.path,
            )),
      ),
  )
  .slice(0, 3 - selectedTagRelatedArticles.length);
const relatedArticles = [
  ...selectedTagRelatedArticles,
  ...categoryFallbackArticles,
];
---

<BaseLayout entry={article}>
  <ArticleHeader
    article={article}
    readingTime={remarkPluginFrontmatter.minutesRead}
  />
  <ContentLayout>
    <Content />
    {
      relatedArticles.length > 0 && (
        <section class="not-prose mt-12 border-t border-base-300 pt-8">
          <h2 class="mb-5 text-2xl font-bold text-base-content">相关阅读</h2>
          <div class="flex snap-x snap-mandatory gap-6 overflow-x-auto overscroll-x-contain pb-3">
            {relatedArticles.map((relatedArticle, index) => (
              <div class="flex-[0_0_clamp(15rem,30%,24rem)] snap-start">
                <NewsCard
                  article={relatedArticle}
                  index={index}
                  showDescription={false}
                  showMetadata={false}
                />
              </div>
            ))}
          </div>
        </section>
      )
    }
    <GiscusComments term={article.data.title} />
  </ContentLayout>
</BaseLayout>

<script>
  const embeds = document.querySelectorAll<HTMLElement>("[data-x-post-id]");
  if (embeds.length > 0) {
    const script = document.createElement("script");
    script.src = "https://platform.x.com/widgets.js";
    script.async = true;
    script.charset = "utf-8";
    script.addEventListener(
      "load",
      () => {
        const widgets = (
          window as Window & {
            twttr?: {
              widgets?: {
                createTweet: (
                  id: string,
                  target: HTMLElement,
                  options?: { dnt?: boolean },
                ) => Promise<unknown>;
              };
            };
          }
        ).twttr?.widgets;

        if (!widgets) return;

        embeds.forEach((embed) => {
          const postId = embed.dataset.xPostId;
          if (!postId) return;

          void widgets
            .createTweet(postId, embed, { dnt: true })
            .then(() =>
              embed.parentElement
                ?.querySelector("[data-x-post-fallback]")
                ?.remove(),
            )
            .catch(() => {});
        });
      },
      { once: true },
    );
    document.head.appendChild(script);
  }
</script>
