---
import { render } from "astro:content";
import BaseLayout from "@/layouts/base.astro";
import ContentLayout from "@/layouts/content.astro";
import ArticleHeader from "./_components/article-header.astro";
import GiscusComments from "@/components/elements/giscus-comments.astro";

import { articlesHandler } from "@/lib/handlers/articles";

export const getStaticPaths = async () => {
  const articles = await articlesHandler.allArticles();

  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
};
const { article } = Astro.props;

const { Content, remarkPluginFrontmatter } = await render(article);
---

<BaseLayout entry={article}>
  <ArticleHeader
    article={article}
    readingTime={remarkPluginFrontmatter.minutesRead}
  />
  <ContentLayout>
    <Content />
    <div
      class="mt-12 p-6 border border-warning/30 bg-warning/5 rounded-xl text-sm italic text-base-content/80"
    >
      <div
        class="flex items-center gap-2 mb-2 text-warning font-bold not-italic"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"
          ></path>
          <path d="M12 9v4"></path>
          <path d="M12 17h.01"></path>
        </svg>
        <span>内容说明</span>
      </div>
      <p>
        本文会尽量区分已确认事实、公司声称、媒体报道、分析、推论与情景。内容用于信息分享与研究讨论，不构成投资、法律或其他专业建议；请结合原始信源独立判断。
      </p>
    </div>
    <GiscusComments term={article.data.title} />
  </ContentLayout>
</BaseLayout>
