---
import { getEntry } from "astro:content";
import TagCloud from "@/components/shared/tag-cloud.astro";
import ListLayout from "@/layouts/list.astro";
import { tagsHandler } from "@/lib/handlers/tags";

const entry = await getEntry("views", "tags");

if (!entry) {
  return Astro.redirect("/404");
}
const [header] = entry.data.blocks;
const tags = await tagsHandler.allTagsWithArticleCounts();
---

<ListLayout header={header.title} entry={entry}>
  <TagCloud tags={tags} />
</ListLayout>
