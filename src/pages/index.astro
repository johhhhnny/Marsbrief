---
import BaseLayout from "@/layouts/base.astro";
import { getEntry } from "astro:content";
import Headlines from "@/pages/_home/headlines.astro";
import LatestNews from "@/pages/_home/latestNews.astro";
import Authors from "@/pages/_home/authors.astro";

const entry = await getEntry("views", "home");

if (!entry) {
  return Astro.redirect("/404");
}
---

<BaseLayout entry={entry}>
  <section class="container pt-12 pb-8 md:pt-20 md:pb-14">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">
      MARS BRIEF
    </p>
    <h1
      class="mt-4 max-w-3xl text-4xl font-serif font-bold leading-tight md:text-6xl"
    >
      看见新闻背后的世界
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-base-content/70">
      从 Musk
      出发，看懂正在形成的未来世界。我们不只是报道新闻，我们提供关于科技、商业与未来的高密度情报。
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/articles">探索深度分析</a>
      <a class="btn btn-outline" href="mailto:brief@marsbrief.com"
        >订阅每周精选</a
      >
    </div>
  </section>
  <div class="container border-y border-primary-content/20 py-6">
    <p class="max-w-3xl text-base leading-7 text-base-content/75">
      在信息过载的时代，您最需要的不是更多的信息，而是清晰的洞察。我们筛选信号、连接因果，并明确区分事实、公司声称与分析判断。
    </p>
  </div>
  <Headlines />
  <LatestNews />
  <Authors />
</BaseLayout>
