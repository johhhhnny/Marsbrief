---
import BaseLayout from "@/layouts/base.astro"; // 导入基础布局组件（包含 html, head, header, footer 等全局结构）
import { getEntry } from "astro:content"; // 导入 Astro 内容集合 API，用于读取特定的 markdown/json 数据
import Headlines from "@/pages/_home/headlines.astro"; // 导入首页专属的“头条”组件
import LatestNews from "@/pages/_home/latestNews.astro"; // 导入首页专属的“最新新闻”组件
import Authors from "@/pages/_home/authors.astro"; // 导入首页专属的“作者团队/专栏作者”组件

// 从 "views" 内容集合中获取标识为 "home" 的单页元数据配置（比如 SEO 相关的 title、description、OG 图片等）
const entry = await getEntry("views", "home");

// 容错处理：如果没找到 views/home 数据，说明可能误删了配置文件，直接重定向到 404 页面
if (!entry) {
  return Astro.redirect("/404");
}
---

<BaseLayout entry={entry}>
  <section class="bg-base-100 text-base-content">
    <div class="w-full overflow-hidden border-b border-white/10">
      <img
        src="/brand/marsbrief-hero.png"
        alt="火星简报 MARS BRIEF：地球、火星与飞向未来的火箭"
        class="block h-auto w-full"
      />
    </div>
  </section>
  <div class="container grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
    <section class="text-center">
      <div class="py-10 md:py-14">
        <div class="mx-auto max-w-3xl">
          <h1
            class="mt-4 text-4xl font-serif font-bold leading-tight md:text-6xl"
          >
            看见新闻背后的世界
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-base-content/75">
            从 Musk
            出发，看懂正在形成的未来世界。我们不只是报道新闻，我们提供关于科技、商业与未来的高密度情报。
          </p>
          <div class="mt-7 flex flex-wrap justify-center gap-3">
            <a class="btn btn-primary" href="/articles">探索深度分析</a>
            <a
              class="btn btn-outline border-base-content/70 text-base-content hover:border-base-content hover:bg-base-content hover:text-base-100"
              href="mailto:brief@marsbrief.com">订阅每日简报</a
            >
          </div>
        </div>
      </div>
    </section>
    <div>
      <Headlines />
    </div>
  </div>
  <LatestNews />
  <Authors />
</BaseLayout>
