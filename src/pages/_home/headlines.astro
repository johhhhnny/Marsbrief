---
import MainHeadline from "@/components/cards/mainHeadline.astro";
import { articlesHandler } from "@/lib/handlers/articles";

const mainHeadlineArticle = await articlesHandler.mainHeadline();

const hasContent = !!mainHeadlineArticle;
---

{
  hasContent && (
    <section
      class="grid grid-cols-1 gap-6 container pt-4 md:pt-8"
      data-pagefind-ignore="all"
    >
      <div class="col-span-1">
        {mainHeadlineArticle && <MainHeadline article={mainHeadlineArticle} />}
      </div>
    </section>
  )
}
