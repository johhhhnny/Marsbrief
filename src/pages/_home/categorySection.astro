---
import NewsCard from "@/components/cards/newsCard.astro";
import HeaderSection from "./headerSection.astro";
import { articlesHandler } from "@/lib/handlers/articles";
import { categoriesHandler } from "@/lib/handlers/categories";

type Props = {
  categoryId: string;
  title: string;
  limit: number;
  showDescription?: boolean;
  clampTitle?: boolean;
};

const {
  categoryId,
  title,
  limit,
  showDescription = true,
  clampTitle = true,
} = Astro.props;
const [category, allArticles] = await Promise.all([
  categoriesHandler.oneCategory(categoryId),
  articlesHandler.allArticles(),
]);

const articles = category
  ? allArticles.filter((article) =>
      categoriesHandler.articleHasCategory(article, category.id),
    )
  : [];
---

{
  articles.length > 0 && (
    <section class="container pt-12 pb-12 space-y-4" data-pagefind-ignore="all">
      <HeaderSection
        title={title}
        link_title="查看全部"
        link_url={`/categories/${category?.data.path ?? categoryId}`}
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 gap-y-6">
        {articles.slice(0, limit).map((article, index) => (
          <NewsCard
            article={article}
            index={index}
            showDescription={showDescription}
            clampTitle={clampTitle}
          />
        ))}
      </div>
    </section>
  )
}
