---
import Github from "@/assets/svgs/github.astro";
import Search01 from "@/assets/svgs/search-01.astro";
import MenuDropdown from "./menu-dropdown.astro";
import { SITE } from "@/lib/config";
import ThemeController from "../bases/theme-controller.astro";
---

<div
  class="navbar border-b border-primary-content/80 dark:border-primary-content/20"
>
  <div class="navbar-start lg:w-1/2">
    <MenuDropdown />
    <a class="flex items-center gap-2 px-2 text-nowrap lg:hidden" href="/">
      <img
        src="/brand/marsbrief-logo.png"
        alt="火星简报 MARS BRIEF"
        class="size-9 rounded-full object-cover"
      />
      <span class="text-lg">{SITE.title}</span>
    </a>
  </div>
  <div class="navbar-center hidden lg:flex">
    <a class="flex items-center gap-2 px-2" href="/">
      <img
        src="/brand/marsbrief-logo.png"
        alt="火星简报 MARS BRIEF"
        class="size-9 rounded-full object-cover"
      />
      <span class="text-xl">{SITE.title}</span>
    </a>
  </div>
  <div class="navbar-end">
    <ThemeController />
    <a class="btn btn-ghost btn-circle" href="/search" aria-label="Search">
      <Search01 />
    </a>
    {
      SITE.github && (
        <a
          class="btn btn-ghost btn-circle"
          href={SITE.github}
          target="_blank"
          aria-label="GitHub"
        >
          <Github />
        </a>
      )
    }
  </div>
</div>
