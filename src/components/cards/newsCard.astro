---
import { Image } from "astro:assets";
import Divider from "../bases/divider.astro";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { categoriesHandler } from "@/lib/handlers/categories";

type Props = {
  article: CollectionEntry<"articles">;
  index: number;
};

const { article, index } = Astro.props;

const { remarkPluginFrontmatter } = await render(article);
const categories = await categoriesHandler.allCategoriesForArticle(article);

const imageProps =
  typeof article.data.cover === "string"
    ? { src: article.data.cover, inferSize: true as const }
    : { src: article.data.cover };
---

<article
  class="col-span-1 group max-w-sm mx-auto flex flex-col gap-3 h-full relative isolate"
>
  <div class="aspect-video overflow-hidden rounded-md">
    <Image
      {...imageProps}
      alt={article.data.cover_alt ? article.data.cover_alt : article.data.title}
      loading={index < 3 ? "eager" : "lazy"}
      layout="constrained"
      class="w-full h-full object-cover"
    />
  </div>
  <div class="flex flex-col flex-1">
    <h3
      class="text-xl font-serif font-extrabold text-base-content lg:group-hover:underline tracking-tight leading-tight line-clamp-2"
    >
      <a href={`/articles/${article.id}`}>
        <span class="absolute inset-0 z-10 pointer-events-none"></span>
        {article.data.title}
      </a>
    </h3>
    <p
      class="mt-3 text-sm text-base-content/60 line-clamp-3 text-pretty lg:mb-auto"
    >
      {article.data.description}
    </p>
    <div class="flex items-center text-xs text-base-content/80 mt-2">
      <span class="text-xs text-primary dark:text-secondary">
        {
          categories
            .map((category) => category?.data.title)
            .filter(Boolean)
            .join("、")
        }
      </span>
      <Divider />
      <span class="text-xs text-base-content/80"
        >{remarkPluginFrontmatter.minutesRead}</span
      >
    </div>
  </div>
</article>
