---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
type Props = {
  author: CollectionEntry<"authors">;
};

const { author } = Astro.props;

const imageProps =
  typeof author.data.avatar === "string"
    ? { src: author.data.avatar }
    : { src: author.data.avatar };
---

<li class="group relative isolate mx-auto w-full">
  <Image
    class="mx-auto aspect-square w-full max-w-[320px] rounded-full object-cover filter grayscale group-hover:grayscale-0"
    {...imageProps}
    alt={author.data.name}
    layout="constrained"
    loading={"lazy"}
    width={320}
    height={320}
  />
  <div class="flex flex-col gap-0.5 mt-2">
    <h3 class="text-base font-bold group-hover:underline">
      <a href={`/authors/${author.id}`}>
        <span class="absolute inset-0 z-10 pointer-events-none"></span>
        {author.data.name}
      </a>
    </h3>
    <p class="text-sm text-primary dark:text-secondary">{author.data.job}</p>
  </div>
</li>
